# ==============================================================================
# RAHUL RAJ PORTFOLIO — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or secret credentials to source control.

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=3000

# Next.js Site & Canonical Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection URI
# e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=

# Optional Redis / Upstash (For distributed rate limiting & session cache)
# REDIS_URL=redis://default:token@host:6379
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# OWNER PANEL & SECURITY
# ------------------------------------------------------------------------------
# Secret Admin Passcode (PIN/Key to unlock /admin Control Studio)
ADMIN_PASSCODE=rahul2148

# Emergency Master Recovery Key (used to reset passcode if forgotten)
ADMIN_RECOVERY_KEY=RAHUL-RECOVER-2026-SECRET

# Target Administrator Notification Email
ADMIN_EMAIL=rahulraj2148@gmail.com

# ------------------------------------------------------------------------------
# EMAIL SMTP SERVICE (Nodemailer)
# ------------------------------------------------------------------------------
# For delivering real Email OTPs and Contact Form Inquiries directly to inbox.
# If SMTP_PASS is empty, the application automatically runs in Dev Simulation Mode.
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=rahulraj2148@gmail.com
SMTP_PASS=
SMTP_FROM="Rahul Raj Portfolio" <rahulraj2148@gmail.com>

# ------------------------------------------------------------------------------
# OPTIONAL THIRD-PARTY INTEGRATIONS
# ------------------------------------------------------------------------------
# Cloudinary (Optional media storage for project galleries)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# GitHub API Token (Optional higher rate limits for fetching repo stats)
# GITHUB_TOKEN=
