# ==============================================================================
# RAHUL RAJ PORTFOLIO — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or secret credentials to source control.

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=3000

# Next.js Site & Canonical Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection URI
# e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=

# Optional Redis / Upstash (For distributed rate limiting & session cache)
# REDIS_URL=redis://default:token@host:6379
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# OWNER PANEL & SECURITY
# ------------------------------------------------------------------------------
# Secret Admin Passcode (Initial master password to unlock /admin Control Studio)
ADMIN_PASSCODE=your_secure_admin_passcode_here

# Target Administrator Notification & Recovery Email
ADMIN_EMAIL=rahulraj21480@gmail.com

# ------------------------------------------------------------------------------
# EMAIL SMTP SERVICE (Nodemailer)
# ------------------------------------------------------------------------------
# For delivering real Email OTPs (to reset passcode) and Contact Form Inquiries.
# If SMTP_PASS is empty, the application automatically runs in Dev Simulation Mode.
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=rahulraj21480@gmail.com
SMTP_PASS=
SMTP_FROM="Rahul Raj Portfolio" <rahulraj21480@gmail.com>

# ------------------------------------------------------------------------------
# CLOUDINARY MEDIA ASSET STORAGE
# ------------------------------------------------------------------------------
# Cloudinary media storage for project screenshots, galleries, and resumes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Optional Custom Avatar URL (Cloudinary or any CDN image URL).
# If not specified, the app automatically defaults to /assets/rahul.jpg from public/assets/
# NEXT_PUBLIC_AVATAR_URL=https://res.cloudinary.com/your-cloud/image/upload/v1/rahul.jpg

# ------------------------------------------------------------------------------
# AI ASSISTANT & LLM ORCHESTRATION (Free Tier Friendly)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get free key: https://aistudio.google.com/)
# Models supported: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash (auto-cascades)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API Key (Get ultra-fast free tier key: https://console.groq.com/)
# Models supported: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI API Key (Fallback if available)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
